{
  "name": "geigeki-kaiiki",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:artifact": "vite build --mode artifact && node scripts/artifact.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "balance": "vitest run test/balance.test.ts --reporter=verbose",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "0.187.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.1.0",
    "wrangler": "4.160.1"
  }
}
