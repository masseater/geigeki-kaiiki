{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "geigeki-kaiiki",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist" },
  "routes": [{ "pattern": "geigeki-kaiiki.masseater.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "logpush": true,
  "observability": { "enabled": true }
}
